{
  "$id": "https://next-clear-look.local/schemas/events/job.cancelled.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "data": {
          "additionalProperties": false,
          "properties": {
            "cancelled_at": {
              "format": "date-time",
              "type": "string"
            },
            "partial_result_urls": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "partial_result_urls",
            "cancelled_at"
          ],
          "type": "object"
        },
        "stream": {
          "const": "job"
        },
        "type": {
          "const": "job.cancelled"
        }
      },
      "required": [
        "type",
        "stream",
        "data"
      ],
      "type": "object"
    }
  ],
  "title": "Next Clear Look job.cancelled event"
}
