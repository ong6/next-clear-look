{
  "$id": "https://next-clear-look.local/schemas/events/job.stage.started.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "data": {
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string"
            },
            "stage": {
              "enum": [
                "catalogue",
                "orbit",
                "archive",
                "raster",
                "likelihood",
                "finalise"
              ],
              "type": "string"
            },
            "total_units": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "stage",
            "total_units",
            "message"
          ],
          "type": "object"
        },
        "stream": {
          "const": "job"
        },
        "type": {
          "const": "job.stage.started"
        }
      },
      "required": [
        "type",
        "stream",
        "data"
      ],
      "type": "object"
    }
  ],
  "title": "Next Clear Look job.stage.started event"
}
