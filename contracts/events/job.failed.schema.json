{
  "$id": "https://next-clear-look.local/schemas/events/job.failed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "data": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "pattern": "^[A-Z][A-Z0-9_]+$",
                  "type": "string"
                },
                "details": {
                  "type": "object"
                },
                "message": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable",
                "details",
                "request_id"
              ],
              "type": "object"
            },
            "partial_result_urls": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "error",
            "partial_result_urls"
          ],
          "type": "object"
        },
        "stream": {
          "const": "job"
        },
        "type": {
          "const": "job.failed"
        }
      },
      "required": [
        "type",
        "stream",
        "data"
      ],
      "type": "object"
    }
  ],
  "title": "Next Clear Look job.failed event"
}
